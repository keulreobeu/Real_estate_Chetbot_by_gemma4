{
  "backend": "transformers",
  "prompt_template": "prompts/grounded_answer_prompt.txt",
  "top_k": 3,
  "max_context_docs": 3,
  "max_output_tokens": 96,
  "temperature": 0.0,
  "top_p": 1.0,
  "repeat_penalty": 1.05,
  "stop_sequences": [
    "\n\n질문:",
    "\n\n근거 문서:"
  ],
  "fallback_on_low_retrieval_score": true,
  "retrieval_score_threshold": 1.0,
  "request_timeout_seconds": 20,
  "web_timeout_seconds": 25
}
