{
  "backend": "llama_cpp",
  "prompt_template": "prompts/grounded_answer_prompt.txt",
  "top_k": 3,
  "max_context_docs": 3,
  "max_output_tokens": 256,
  "temperature": 0.1,
  "top_p": 0.9,
  "repeat_penalty": 1.1,
  "stop_sequences": [
    "\n\n질문:",
    "\n\n근거 문서:"
  ],
  "fallback_on_low_retrieval_score": true,
  "retrieval_score_threshold": 1.0
}
